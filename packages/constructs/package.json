{
  "name": "@app/constructs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0"
  },
  "devDependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
