{
  "name": "server",
  "version": "1.0.0",
  "description": "URL Shortener Server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run --config test/vitest.config.ts",
    "test:unit:watch": "vitest --config test/vitest.config.ts",
    "test:e2e": "playwright test --config test/playwright.config.ts",
    "test:e2e:ui": "playwright test --config test/playwright.config.ts --ui",
    "infra:synth": "cdk synth",
    "infra:diff": "cdk diff",
    "infra:deploy": "cdk deploy --all"
  },
  "devDependencies": {
    "@app/infra-core": "workspace:*",
    "@app/types": "workspace:*",
    "@playwright/test": "^1.41.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pino-http": "^5.8.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "aws-cdk": "^2.1139.0",
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@app/error": "workspace:*",
    "@app/utils": "workspace:*",
    "@aws-sdk/client-dynamodb": "^3.1111.0",
    "@aws-sdk/lib-dynamodb": "^3.1111.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "zod": "^3.23.8"
  }
}
